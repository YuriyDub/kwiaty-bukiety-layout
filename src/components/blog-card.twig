<article class="flex flex-col overflow-hidden rounded-3xl lg:rounded-[32px] border border-[#e0e0d7] bg-background {{ class|default('') }}">
	<div class="relative">
		<img src="{{ post.img.src|default('/images/placeholder.jpg') }}" alt="{{ post.img.alt|default(post.title) }}" class="w-full aspect-[3/2] object-cover">
		{% if post.date %}
			<span class="lg:hidden absolute top-2 right-2 flex items-center gap-1 md:gap-2 px-2 py-1 md:px-3 md:py-2 bg-black/30 md:bg-black/40 rounded-full text-white text-[13px] leading-5 md:text-base md:leading-6">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
					<rect x="3" y="4" width="18" height="18" rx="2"/>
					<path d="M16 2v4M8 2v4M3 10h18"/>
				</svg>
				{{ post.date }}
			</span>
		{% endif %}
	</div>

	<div class="flex grow flex-col gap-4 p-3">
		<div class="flex flex-col gap-2">
			<h2 class="text-[16px] font-semibold md:text-[22px] md:font-bold text-gray-1">{{ post.title }}</h2>
			{% if post.excerpt %}
				<p class="text-[13px] leading-5 md:text-base md:leading-6 text-[#5a6561] line-clamp-2 md:line-clamp-3 lg:line-clamp-2">{{ post.excerpt }}</p>
			{% endif %}
		</div>

		<div class="mt-auto w-full lg:max-w-53.5">
			{% include "./button.twig" with {
				text: 'Read more',
				link: post.link|default('#'),
				target: post.target|default('_self'),
				variant: 'border',
				size: 'md',
				showIcon: false,
				class: 'h-13 w-full max-md:text-[14px]'
			} only %}
		</div>
	</div>
</article>
