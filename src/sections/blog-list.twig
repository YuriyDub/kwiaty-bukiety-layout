<section class="text-dark-text">
	{% embed "../layouts/container.twig" %}
		{% block content %}
			<div class="flex flex-col gap-6 md:gap-10 lg:gap-12">
				<div class="flex flex-col gap-2 lg:gap-3">
					{% if fields.title %}
						<h1 class="text-[22px] font-extrabold md:text-[40px] md:font-bold md:leading-tight text-green-default">{{ fields.title }}</h1>
					{% endif %}
					{% if fields.subtitle %}
						<p class="text-body-15 md:text-base md:leading-6 text-gray-1 max-w-2xl">{{ fields.subtitle }}</p>
					{% endif %}
				</div>

				{% set featured = fields.posts|first %}
				{% if featured %}
					<div class="hidden lg:grid lg:grid-cols-2 lg:gap-6 lg:items-start">
						<img src="{{ featured.img.src|default('/images/placeholder.jpg') }}" alt="{{ featured.img.alt|default(featured.title) }}" class="w-full aspect-[835/480] object-cover rounded-[32px]">

						<div class="flex flex-col gap-8 py-3.5">
							{% if featured.date %}
								<span class="flex items-center gap-2 text-base leading-6 text-[#969998]">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
										<rect x="3" y="4" width="18" height="18" rx="2"/>
										<path d="M16 2v4M8 2v4M3 10h18"/>
									</svg>
									{{ featured.date }}
								</span>
							{% endif %}

							<div class="flex flex-col gap-4">
								<h2 class="text-[32px] font-semibold leading-tight text-gray-1">{{ featured.title }}</h2>
								{% if featured.excerpt %}
									<p class="text-base leading-6 text-[#5a6561]">{{ featured.excerpt }}</p>
								{% endif %}
							</div>

							<div class="w-full max-w-70">
								{% include "../components/button.twig" with {
									text: 'Read more',
									link: featured.link|default('#'),
									variant: 'border',
									size: 'md',
									showIcon: false,
									class: 'h-13 w-full'
								} only %}
							</div>
						</div>
					</div>
				{% endif %}

				{% if fields.posts %}
					<div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-x-3 md:gap-y-5 lg:grid-cols-3">
						{% if featured %}
							{% include "../components/blog-card.twig" with {post: featured, class: 'md:col-span-2 lg:hidden'} only %}
						{% endif %}
						{% for post in fields.posts|slice(1) %}
							{% include "../components/blog-card.twig" with {post: post} only %}
						{% endfor %}
					</div>
				{% endif %}

				{% if fields.button %}
					<div class="lg:hidden w-full md:max-w-72.5 md:mx-auto">
						{% include "../components/button.twig" with {
							text: fields.button.text,
							link: fields.button.link,
							variant: fields.button.variant|default('purple'),
							size: fields.button.size|default('lg'),
							showIcon: false
						} %}
					</div>
				{% endif %}

				{% if fields.pagination %}
					<div class="hidden lg:flex justify-center">
						{% include "../components/pagination.twig" with fields.pagination only %}
					</div>
				{% endif %}
			</div>
		{% endblock %}
	{% endembed %}
</section>
